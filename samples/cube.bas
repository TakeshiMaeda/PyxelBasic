20 DIM E1(12),E2(12):VSYNC CLEAR
100 FOR I=0 TO 7
112 READ VX(I),VY(I),VZ(I)
130 NEXT
140 FOR I= 0 TO 11
142 READ E1(I),E2(I)
144 NEXT
145 CLS 2
150 FOR I=0 TO 7
160 X=VX(I):Y=VY(I):Z=VZ(I)
200 C=COS(RZ)
210 S=SIN(RZ)
220 AX = X*C - Y*S
230 AY = X*S + Y*C
250 X=AX:Y=AY
300 C = COS(RY)
310 S = SIN(RY)
320 AX = Z*C - X*S
340 AZ = Z*S + X*C
350 X=AX:Z=AZ
560 PX(I)=X/(Z+4)*100+100
570 PY(I)=Y/(Z+4)*100+100
590 NEXT
600 FOR I=0 TO 11
630 LINE(PX(E1(I)),PY(E1(I)))-(PX(E2(I)),PY(E2(I))),12
640 NEXT
700 RZ=RZ+RAD(1)
720 RY=RY+RAD(5)
730 VSYNC : GOTO 145
1000 DATA -1,-1,-1
1010 DATA -1, 1,-1
1020 DATA  1, 1,-1
1030 DATA  1,-1,-1
1040 DATA -1,-1, 1
1050 DATA -1, 1, 1
1060 DATA  1, 1, 1
1070 DATA  1,-1, 1
1210 DATA 0,1, 1,2, 2,3, 3,0
1220 DATA 4,5, 5,6, 6,7, 7,4
1230 DATA 0,4, 1,5, 2,6, 3,7
