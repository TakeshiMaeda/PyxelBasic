10 REM 3D CUBE PUZZLE WITH AUTO-SOLVE
15 VSYNC CLEAR
20 DIM X(7), Y(7), Z(7)
30 DATA -8,-8,-8, 8,-8,-8, 8, 8,-8, -8, 8,-8
40 DATA -8,-8, 8, 8,-8, 8, 8, 8, 8, -8, 8, 8
50 FOR I=0 TO 7: READ X(I), Y(I), Z(I): NEXT I
60 DATA 4,5,6,8, 4,6,7,8, 1,0,3,9, 1,3,2,9
70 DATA 7,6,2,7, 7,2,3,7, 0,1,5,10, 0,5,4,10
80 DATA 0,4,7,11, 0,7,3,11, 5,1,2,12, 5,2,6,12
90 DIM F1(11), F2(11), F3(11), DFC(11)
100 FOR I=0 TO 11: READ F1(I), F2(I), F3(I), DFC(I): NEXT I
102 DIM IDX(26), ZR(26)
104 FOR I=0 TO 26: IDX(I)=I: NEXT I
106 DIM CX(26), CY(26), CZ(26)
110 C=0
120 FOR GX=-1 TO 1
130 FOR GY=-1 TO 1
140 FOR GZ=-1 TO 1
150 CX(C)=GX*28: CY(C)=GY*28: CZ(C)=GZ*28
160 C=C+1
170 NEXT GZ: NEXT GY: NEXT GX
172 DIM FC(323)
174 FOR CUBE=0 TO 26: FOR I=0 TO 11: FC(CUBE*12+I)=DFC(I): NEXT I: NEXT CUBE
180 DIM S(359), C(359)
190 FOR I=0 TO 359: R=RAD(I): S(I)=SIN(R): C(I)=COS(R): NEXT I
200 A=20: B=30: HP=0: MODE=0: SC=0
210 LA=0: LD=0: LY=99: LX=99: SRT=0
220 DIM RXR(7), RZR(7), RYR(7), H(99)
230 CLS
240 LOCATE 0, 0: PRINT "KEYS 1,2,4,5:HORIZ  3,6,7,8:VERT"
250 LOCATE 0, 1: PRINT "S:SCRAMBLE  A:SOLVE"
252 LOCATE 0, 2: PRINT "HIST STACK:"; HP
254 LOCATE 0, 3: PRINT "LA:"; LA; " LY:"; LY; " LX:"; LX
260 CA=C(A): SA=S(A): CB=C(B): SB=S(B)
270 AA=LA: IF LD=-1 THEN AA=(360-LA) MOD 360
280 CR=C(AA): SR=S(AA)
285 IF LA > 0 THEN SRT=0
290 IF SRT=1 THEN GOTO 410
300 FOR CUBE=0 TO 26
310 XV=CX(CUBE): YV=CY(CUBE): ZV=CZ(CUBE)
320 IF LY >= 90 OR ABS(YV - LY) >= 4 THEN GOTO 335
330 R1=XV*CR-ZV*SR: ZV=XV*SR+ZV*CR: XV=R1
335 IF LX >= 90 OR ABS(XV - LX) >= 4 THEN GOTO 340
336 R1=YV*CR-ZV*SR: ZV=YV*SR+ZV*CR: YV=R1
340 R1=XV*CB-ZV*SB: R2=XV*SB+ZV*CB
350 RCZ=YV*SA+R2*CA
360 ZR(CUBE)=RCZ
370 NEXT CUBE
380 FOR I=0 TO 25: FLG=0: FOR J=0 TO 25-I
390 IF ZR(IDX(J)) >= ZR(IDX(J+1)) THEN GOTO 405
400 T=IDX(J): IDX(J)=IDX(J+1): IDX(J+1)=T: FLG=1
405 NEXT J
406 IF FLG=0 THEN I=25
408 NEXT I
409 SRT=1
410 IF LY >= 90 THEN GOTO 430
420 FOR I=0 TO 7: RXR(I)=X(I)*CR-Z(I)*SR: RZR(I)=X(I)*SR+Z(I)*CR: NEXT I
430 IF LX >= 90 THEN GOTO 440
432 FOR I=0 TO 7: RYR(I)=Y(I)*CR-Z(I)*SR: RZR(I)=Y(I)*SR+Z(I)*CR: NEXT I
440 FOR C=0 TO 26
450 CUBE=IDX(C)
460 TCX=CX(CUBE): TCY=CY(CUBE): TCZ=CZ(CUBE)
470 IR=0: IF LY < 90 AND ABS(TCY - LY) < 4 THEN IR=1
472 IF LX < 90 AND ABS(TCX - LX) < 4 THEN IR=2
480 IF IR=1 THEN GOTO 520
490 IF IR=2 THEN GOTO 550
500 FOR I=0 TO 7: PX=TCX+X(I): PY=TCY+Y(I): PZ=TCZ+Z(I): R1=PX*CB-PZ*SB: GZ=PX*SB+PZ*CB: GX=R1: GY=PY*CA-GZ*SA: GZ=PY*SA+GZ*CA: SX(I)=128+GX*250/(GZ+350): SY(I)=128-GY*250/(GZ+350): NEXT I: GOTO 590
520 RTCX=TCX*CR-TCZ*SR: RTCZ=TCX*SR+TCZ*CR
530 FOR I=0 TO 7: PX=RTCX+RXR(I): PY=TCY+Y(I): PZ=RTCZ+RZR(I): R1=PX*CB-PZ*SB: GZ=PX*SB+PZ*CB: GX=R1: GY=PY*CA-GZ*SA: GZ=PY*SA+GZ*CA: SX(I)=128+GX*250/(GZ+350): SY(I)=128-GY*250/(GZ+350): NEXT I: GOTO 590
550 RTCY=TCY*CR-TCZ*SR: RTCZ=TCY*SR+TCZ*CR
560 FOR I=0 TO 7: PX=TCX+X(I): PY=RTCY+RYR(I): PZ=RTCZ+RZR(I): R1=PX*CB-PZ*SB: GZ=PX*SB+PZ*CB: GX=R1: GY=PY*CA-GZ*SA: GZ=PY*SA+GZ*CA: SX(I)=128+GX*250/(GZ+350): SY(I)=128-GY*250/(GZ+350): NEXT I
590 FOR I=0 TO 11
610 X1=SX(F1(I)): Y1=SY(F1(I)): X2=SX(F2(I)): Y2=SY(F2(I)): X3=SX(F3(I)): Y3=SY(F3(I))
620 CRV=(X2-X1)*(Y3-Y1)-(Y2-Y1)*(X3-X1)
630 IF CRV > 0 THEN TRIF (X1,Y1)-(X2,Y2)-(X3,Y3), FC(CUBE*12+I)
640 NEXT I
650 NEXT C
660 VSYNC
670 IF LY >= 90 AND LX >= 90 THEN GOTO 740
680 LA=LA+6
690 IF LA < 90 THEN GOTO 230
700 LA=0
710 FOR CUBE=0 TO 26
711 IF LY >= 90 THEN GOTO 725
712 IF ABS(CY(CUBE) - LY) >= 4 THEN GOTO 735
713 TCX=CX(CUBE): TCZ=CZ(CUBE)
714 IF LD=1 THEN CX(CUBE)=-TCZ: CZ(CUBE)=TCX: T1=FC(CUBE*12+8): T2=FC(CUBE*12+9): FC(CUBE*12+8)=FC(CUBE*12+0): FC(CUBE*12+9)=FC(CUBE*12+1): FC(CUBE*12+0)=FC(CUBE*12+10): FC(CUBE*12+1)=FC(CUBE*12+11): FC(CUBE*12+10)=FC(CUBE*12+2): FC(CUBE*12+11)=FC(CUBE*12+3): FC(CUBE*12+2)=T1: FC(CUBE*12+3)=T2
715 IF LD=-1 THEN CX(CUBE)=TCZ: CZ(CUBE)=-TCX: T1=FC(CUBE*12+10): T2=FC(CUBE*12+11): FC(CUBE*12+10)=FC(CUBE*12+0): FC(CUBE*12+11)=FC(CUBE*12+1): FC(CUBE*12+0)=FC(CUBE*12+8): FC(CUBE*12+1)=FC(CUBE*12+9): FC(CUBE*12+8)=FC(CUBE*12+2): FC(CUBE*12+9)=FC(CUBE*12+3): FC(CUBE*12+2)=T1: FC(CUBE*12+3)=T2
716 GOTO 735
725 IF LX >= 90 THEN GOTO 735
726 IF ABS(CX(CUBE) - LX) >= 4 THEN GOTO 735
727 TCY=CY(CUBE): TCZ=CZ(CUBE)
728 IF LD=1 THEN CY(CUBE)=-TCZ: CZ(CUBE)=TCY: T1=FC(CUBE*12+0): T2=FC(CUBE*12+1): FC(CUBE*12+0)=FC(CUBE*12+4): FC(CUBE*12+1)=FC(CUBE*12+5): T3=FC(CUBE*12+6): T4=FC(CUBE*12+7): FC(CUBE*12+6)=T1: FC(CUBE*12+7)=T2: T1=FC(CUBE*12+2): T2=FC(CUBE*12+3): FC(CUBE*12+2)=T3: FC(CUBE*12+3)=T4: FC(CUBE*12+4)=T1: FC(CUBE*12+5)=T2
729 IF LD=-1 THEN CY(CUBE)=TCZ: CZ(CUBE)=-TCY: T1=FC(CUBE*12+4): T2=FC(CUBE*12+5): FC(CUBE*12+4)=FC(CUBE*12+0): FC(CUBE*12+5)=FC(CUBE*12+1): T3=FC(CUBE*12+2): T4=FC(CUBE*12+3): FC(CUBE*12+2)=T1: FC(CUBE*12+3)=T2: T1=FC(CUBE*12+6): T2=FC(CUBE*12+7): FC(CUBE*12+6)=T3: FC(CUBE*12+7)=T4: FC(CUBE*12+0)=T1: FC(CUBE*12+1)=T2
735 NEXT CUBE
736 LY=99: LX=99: SRT=0: GOTO 230
740 K=STICK(0)
742 IF K AND 1 THEN A=(A+3) MOD 360: SRT=0
744 IF K AND 2 THEN A=(A+357) MOD 360: SRT=0
746 IF K AND 8 THEN B=(B+3) MOD 360: SRT=0
748 IF K AND 4 THEN B=(B+357) MOD 360: SRT=0
750 IF MODE=1 THEN GOTO 850
752 IF MODE=2 THEN GOTO 900
754 K$=INKEY$
760 IF K$="1" THEN LY=28: LD=1: GOSUB 1000: SRT=0: GOTO 230
762 IF K$="2" THEN LY=-28: LD=1: GOSUB 1000: SRT=0: GOTO 230
764 IF K$="3" THEN LX=28: LD=1: GOSUB 1000: SRT=0: GOTO 230
766 IF K$="4" THEN LY=28: LD=-1: GOSUB 1000: SRT=0: GOTO 230
768 IF K$="5" THEN LY=-28: LD=-1: GOSUB 1000: SRT=0: GOTO 230
770 IF K$="6" THEN LX=28: LD=-1: GOSUB 1000: SRT=0: GOTO 230
772 IF K$="7" THEN LX=-28: LD=1: GOSUB 1000: SRT=0: GOTO 230
774 IF K$="8" THEN LX=-28: LD=-1: GOSUB 1000: SRT=0: GOTO 230
776 IF K$="S" OR K$="s" THEN MODE=1: SC=15: SRT=0: GOTO 230
778 IF K$="A" OR K$="a" THEN MODE=2: SRT=0: GOTO 230
780 GOTO 230
850 IF SC <= 0 THEN MODE=0: GOTO 230
860 RNDVAL=INT(RND(8))
865 IF SC < 15 AND (RNDVAL MOD 4) = (PM MOD 4) THEN GOTO 860
870 PM=RNDVAL
872 LY=99: LX=99: LD=1: IF RNDVAL >= 4 THEN LD=-1
880 AM=RNDVAL MOD 4
890 IF AM=0 THEN LY=28
891 IF AM=1 THEN LY=-28
892 IF AM=2 THEN LX=28
893 IF AM=3 THEN LX=-28
894 GOSUB 1000
895 SC=SC-1
896 GOTO 230
900 IF HP <= 0 THEN MODE=0: GOTO 230
910 HP=HP-1: MC=H(HP)
920 RMC=MC+4: IF MC >= 4 THEN RMC=MC-4
930 LY=99: LX=99: LD=1: IF RMC >= 4 THEN LD=-1
940 AM=RMC MOD 4
950 IF AM=0 THEN LY=28
960 IF AM=1 THEN LY=-28
970 IF AM=2 THEN LX=28
980 IF AM=3 THEN LX=-28
990 GOTO 230
1000 IF HP >= 99 THEN RETURN
1010 MC=0
1020 IF LY=28 AND LD=1 THEN MC=0
1030 IF LY=-28 AND LD=1 THEN MC=1
1040 IF LX=28 AND LD=1 THEN MC=2
1050 IF LX=-28 AND LD=1 THEN MC=3
1060 IF LY=28 AND LD=-1 THEN MC=4
1070 IF LY=-28 AND LD=-1 THEN MC=5
1080 IF LX=28 AND LD=-1 THEN MC=6
1090 IF LX=-28 AND LD=-1 THEN MC=7
1100 H(HP)=MC: HP=HP+1: RETURN
