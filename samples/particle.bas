5 VSYNC CLEAR : PALETTE RESET
10 C$="77770000":SET SPRITE 0,C$+C$+C$+C$
20 C$="66660000":SET SPRITE 1,C$+C$+C$+C$
30 C$="cccc0000":SET SPRITE 2,C$+C$+C$+C$
40 MS=255:G=9.8/60
50 DIM X(MS),Y(MS),XA(MS),YA(MS),W(MS),C(MS)
60 FOR I=0 TO MS
70 S=I:GOSUB 1000
80 NEXT
100 FOR I=0 TO MS
110 W(I)=W(I)-1:IF W(I)>0 THEN 200
120 X(I)=X(I)+XA(I):Y(I)=Y(I)+YA(I):YA(I)=YA(I)+G
130 C(I)=(C(I)+1) MOD 3
200 PUT SPRITE I,(X(I),Y(I)),C(I),0,0
210 IF Y(I)>256 THEN S=I:GOSUB 1000
300 NEXT
320 VSYNC:GOTO 100
999 END
1000 X(S)=128+RND(10)-5:Y(S)=256:XA(S)=RND()-0.5:YA(S)=-RND(4)-5:W(S)=FIX(RND(60))+30:C(S)=FIX(RND(100)) MOD 3
1010 RETURN
